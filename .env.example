# GEMINI_API_KEY: Required for Google Gemini generative AI calls.
# Get an API key from Google AI / Google Cloud console: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The public or local URL where this application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Atlas collection connection string
# Paste your standard MongoDB Atlas driver connection string here (e.g., mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI=

# APIFY_API_TOKEN: Optional Token from apify.com (e.g. ap_XXXXXX)
# Used for high-fidelity behind-the-scenes Instagram & TikTok MP4 video downloading and verbal transcription.
APIFY_API_TOKEN=

